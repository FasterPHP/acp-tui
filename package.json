{
  "name": "acp-tui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FasterPHP/acp-tui"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun scripts/test.ts",
    "bench:scale": "bun packages/acp-tui/bench/scale.ts",
    "bench:load": "bun packages/acp-tui/bench/load.ts",
    "bench:find": "bun packages/acp-tui/bench/find.ts",
    "test:windows": "bun scripts/test-windows.ts",
    "install-cli": "bun packages/acp-tui/scripts/install-cli.ts",
    "typecheck": "tsc --noEmit -p packages/acp-model/tsconfig.json && tsc --noEmit -p packages/acp-tui/tsconfig.json && tsc --noEmit -p packages/fake-agent/tsconfig.json",
    "update": "bun scripts/update.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/bun": "1.4.2"
  }
}
